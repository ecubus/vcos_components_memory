                                <SHORT-NAME>RTE_RIPS_CONSIDER_MODE_DISABLINGS</SHORT-NAME>
                                <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              </ECUC-ENUMERATION-LITERAL-DEF>
