                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1d526dbf-73e8-4c71-abfb-b1d9a2cfa016">
                      <SHORT-NAME>NvMBlockJobPriority</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the job priority for a NVRAM block (0 = Immediate priority).</L-2>
                        <L-2 L="ZH">概述：NvMBlockJobPriority配置项用于定义非易失性内存（NVM）块的作业优先级，确保在NVM管理器中处理存储和恢复操作时，能够根据优先级顺序执行。</L-2>
                        <L-2 L="ZH">注意：优先级设置应考虑系统的实时性和数据重要性，避免低优先级作业长时间阻塞；在配置时需确保不同NVM块间的优先级分配合理，以防止优先级倒置问题；</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00477</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1031f94b-1419-4708-9937-a3edac24e9a7">
                      <SHORT-NAME>NvMMaxNumOfReadRetries</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the maximum number of read retries.</L-2>
                        <L-2 L="ZH">概述：NvMMaxNumOfReadRetries 配置项用于指定非易失性内存管理（NvM）模块在读取操作失败后可以重试的最大次数，以提高数据读取的可靠性。</L-2>
                        <L-2 L="ZH">注意：该值应根据存储介质的可靠性和系统的容错需求来设置；设置过高可能会导致系统响应时间延迟；确保该配置项的值与系统定义的错误处理策略相匹配。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00533</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>7</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:78e2ed49-7ea2-41fd-ac91-2f65c9cd8908">
                      <SHORT-NAME>NvMMaxNumOfWriteRetries</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the maximum number of write retries for a NVRAM block with [ECUC_NvM_00061]. Regardless of configuration a consistency check (and maybe write retries) are always forced for each block which is processed by the request nvm_write_all and nvm_write_block.</L-2>
                        <L-2 L="ZH">概述：NvMMaxNumOfWriteRetries 配置项用于指定非易失性内存管理（NvM）模块在写入操作失败后可以重试的最大次数，以提高数据存储的可靠性。</L-2>
                        <L-2 L="ZH">注意：该值应根据存储介质的可靠性和系统的容错需求来设置；设置过高可能会导致系统响应时间变长；确保该配置项的值符合实际的内存硬件特性和系统需求。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00499</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>7</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:087b96a3-afec-4a8f-b375-50fdeaa19b1c">
                      <SHORT-NAME>NvMNvBlockBaseNumber</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configuration parameter to perform the link between the NVM_NVRAM_BLOCK_IDENTIFIER used by the SW-Cs and the FEE_BLOCK_NUMBER expected by the memory abstraction modules. The parameter value equals the FEE_BLOCK_NUMBER or EA_BLOCK_NUMBER shifted to the right by NvMDatasetSelectionBits bits. (ref. to chapter 7.1.2.1).</L-2>
                        <L-2 L="ZH">概述：NvMNvBlockBaseNumber 用于定义非易失性内存块（NvM Block）的基础编号，这是一个全局唯一的标识符，用于区分存储在非易失性内存中的不同数据块。</L-2>
                        <L-2 L="ZH">注意：确保每个NvM Block的NvMNvBlockBaseNumber是唯一的，以避免数据覆盖或错误访问；在系统设计阶段需要仔细规划这些编号，以保持系统的可扩展性和维护性；</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Calculation Formula:
                                        value = TargetBlockReference.[Ea/Fee]BlockConfiguration.[Ea/Fee]BlockNumber &gt;&gt; NvMDatasetSelectionBits</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00478</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65534</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:60ef00b3-517e-49f5-8942-16bc295ac588">
                      <SHORT-NAME>NvMNvBlockLength</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the NV block data length in bytes.</L-2>
                        <L-2 L="ZH">概述：NvMNvBlockLength 定义了非易失性内存块（NvM Block）的长度，用于存储特定数据。</L-2>
                        <L-2 L="ZH">注意：确保NvMNvBlockLength与实际存储需求相匹配，避免数据溢出；长度应根据数据结构和存储需求进行精确配置；对于NvMNvBlockLength的配置应符合模块的内存管理策略。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Note:
                                        The implementer can add the attribute 'withAuto' to the parameter definition which indicates that the length can be calculated by the generator automatically (e.g. by using the sizeof operator).
                                        When 'withAuto' is set to 'true' for this parameter definition the 'isAutoValue' can be set to 'true'.
                                        If 'isAutoValue' is set to 'true' the actual value will not be considered during ECU Configuration but will be (re-)calculated by the code generator and stored in the value attribute afterwards.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00479</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:77ade3a7-ce59-440d-a7e7-15fd9adefe05">
                      <SHORT-NAME>NvMNvBlockNum</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the number of multiple NV blocks in a contiguous area according to the given block management type.</L-2>
                        <L-2 L="ZH">概述：NvMNvBlockNum配置项用于定义非易失性内存（NVM）管理模块中的块数量，这是一个关键参数，用于指导NVM管理模块如何组织和管理内存块。</L-2>
                        <L-2 L="ZH">注意：NvMNvBlockNum的值必须准确反映项目中使用的NVM块的总数；配置值过大或过小都会影响系统性能和内存使用效率；确保该配置项与实际NVM布局和需求相匹配。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">1-255      For NVRAM blocks to be configured of block management type NVM_BLOCK_DATASET. The actual range is limited according to SWS_NvM_00444.

                                        1              For NVRAM blocks to be configured of block management type NVM_BLOCK_NATIVE

                                        2              For NVRAM blocks to be configured of block management type NVM_BLOCK_REDUNDANT</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00480</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>255</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:6ad9681e-a4cf-4630-96f8-0843c5a1f5ab">
                      <SHORT-NAME>NvMNvramBlockIdentifier</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Identification of a NVRAM block via a unique block identifier.</L-2>
                        <L-2 L="ZH">概述：NvMNvramBlockIdentifier用于唯一标识非易失性内存（NVRAM）管理模块中的一个NVRAM块，确保每个NVRAM块可以被准确识别和访问。</L-2>
                        <L-2 L="ZH">注意：NvMNvramBlockIdentifier的值必须在整个系统中唯一，避免标识符冲突；在配置时应确保与系统中其他模块的标识符不重复；该标识符的配置和使用应遵循NVRAM管理模块的规范要求。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Implementation Type: nvm_block_id_t.

                                        min = 2 max = 2^(16- NVM_DATASET_SELECTION_BITS)-1

                                        Reserved NVRAM block IDs:
                                        0 -&gt; to derive multi block request results via nvm_get_error_status
                                        1 -&gt; redundant NVRAM block which holds the configuration ID (generation tool should check that this block is correctly configured from type,CRC and size point of view)</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00481</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:90f689ce-cc95-450a-a7d9-8a7044711d54">
                      <SHORT-NAME>NvMNvramDeviceId</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the NVRAM device ID where the NVRAM block is located.</L-2>
                        <L-2 L="ZH">概述：NvMNvramDeviceId 是用于标识非易失性内存（NVRAM）管理模块中特定设备的唯一标识符，用于区分不同的存储设备。</L-2>
                        <L-2 L="ZH">注意：在配置NvMNvramDeviceId时，必须确保每个NVRAM设备有一个唯一的标识符；该标识符通常由系统设计者分配，并在整个系统中保持一致；应检查该标识符是否符合规定的数据类型和取值范围。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Calculation Formula:
                                        value = TargetBlockReference.[Ea/Fee]BlockConfiguration.[Ea/Fee]DeviceIndex</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00035</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>1</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:ddfe3c46-ad54-463e-b8b4-1e15564ae1b8">
                      <SHORT-NAME>NvMRomBlockNum</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the number of multiple ROM blocks in a contiguous area according to the given block management type.</L-2>
                        <L-2 L="ZH">概述：NvMRomBlockNum是一个配置项，用于指定非易失性内存（NVM）中只读存储器（ROM）块的数量，这些块通常用于存储默认或固定的数据。</L-2>
                        <L-2 L="ZH">注意：在配置NvMRomBlockNum时，需要确保指定的块数量与实际在系统中实现的ROM块数量相匹配；超出实际数量的配置可能导致系统资源浪费或配置错误；</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">0-254      For NVRAM blocks to be configured of block management type NVM_BLOCK_DATASET. The actual range is limited according to SWS_NvM_00444.

                                        0-1          For NVRAM blocks to be configured of block management type NVM_BLOCK_NATIVE

                                        0-1          For NVRAM blocks to be configured of block management type NVM_BLOCK_REDUNDANT</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00485</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MAX>254</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e044b935-bdee-42de-8b16-eda9a7279e49">
                      <SHORT-NAME>NvMWriteVerificationDataSize</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the number of bytes to compare in each step when comparing the content of a RAM Block and a block read back.</L-2>
                        <L-2 L="ZH">概述：NvMWriteVerificationDataSize配置项指定了非易失性内存管理（NvM）模块在写操作后用于验证数据完整性的数据大小。</L-2>
                        <L-2 L="ZH">注意：必须确保配置的数据大小不超过实际NvM块的大小；此外，考虑到性能和可靠性的平衡，应当根据存储介质的特性和系统的可靠性要求慎重选择验证数据的大小；如果配置的数据大小为零，则表示不执行写后验证。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                            <SD GID="VCOS:CfgValue">1</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00538</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-STRING-PARAM-DEF UUID="ECUC:9728f9b6-285d-4bc5-83b7-2fe23a9ec4cb">
                      <SHORT-NAME>NvMBlockHeaderInclude</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the header file where the owner of the NVRAM block has the declarations of the permanent RAM data block, ROM data block (if configured) and the callback function prototype for each configured callback. If no permanent RAM block, ROM block or callback functions are configured then this configuration parameter shall be ignored.</L-2>
                        <L-2 L="ZH">概述：NvMBlockHeaderInclude配置项用于指定是否为非易失性内存(NvM)块包含一个额外的头部信息，这有助于管理和识别存储的数据块。</L-2>
                        <L-2 L="ZH">注意：确保当需要对NvM块进行版本控制或状态管理时启用此选项；过多使用头部信息可能会增加存储开销；正确配置头部信息以避免数据一致性问题。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                            <SD GID="VCOS:CfgValue">NULL</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00554</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <ECUC-STRING-PARAM-DEF-VARIANTS>
                        <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                    </ECUC-STRING-PARAM-DEF>
                    <ECUC-STRING-PARAM-DEF UUID="ECUC:dad1e4d8-a71a-4307-938f-cebe91afb72b">
                      <SHORT-NAME>NvMRamBlockDataAddress</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the start address of the RAM block data.</L-2>
                        <L-2 L="ZH">概述：NvMRamBlockDataAddress 用于定义非易失性内存块在RAM中的起始地址，这是数据在运行时被存储和访问的位置。</L-2>
                        <L-2 L="ZH">注意：确保地址与其他内存管理配置不冲突；地址应符合硬件的内存寻址规范；在多任务或多核环境中，注意数据的同步和一致性问题。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">If this is not configured, no permanent RAM data block is available for the selected block management type.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00482</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <ECUC-STRING-PARAM-DEF-VARIANTS>
                        <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                    </ECUC-STRING-PARAM-DEF>
                    <ECUC-STRING-PARAM-DEF UUID="ECUC:c211eaf4-e050-4bec-8a1b-3423cd203f7d">
                      <SHORT-NAME>NvMRomBlockDataAddress</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the start address of the ROM block data.</L-2>
                        <L-2 L="ZH">概述：NvMRomBlockDataAddress配置项用于指定非易失性内存（NVM）块的ROM区域地址，这是存储默认数据或固定数据的物理地址。</L-2>
                        <L-2 L="ZH">注意：确保地址与实际的硬件内存映射一致，避免地址冲突；在配置时需考虑内存对齐要求；该地址应指向只读内存区域，以防止运行时数据被意外修改。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">If not configured, no ROM block is available for the selected block management type.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00484</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <ECUC-STRING-PARAM-DEF-VARIANTS>
                        <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                    </ECUC-STRING-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:bdbb119b-7ccd-46ea-9a91-2bfa0300418e">
                      <SHORT-NAME>NvMTargetBlockReference</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter is just a container for the parameters for EA and FEE</L-2>
                        <L-2 L="ZH">概述：NvMTargetBlockReference配置项用于指定非易失性内存管理（NvM）模块中目标块的引用，它确保了数据块在内存中的正确定位和管理。</L-2>
                        <L-2 L="ZH">注意：在配置NvMTargetBlockReference时，必须确保引用的目标块已在系统中定义且配置正确；该配置项对于实现数据的持久存储至关重要，错误的配置可能导致数据丢失或损坏；</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00486</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <CHOICES>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:90f4fd54-5801-429b-9642-06ef3acc3387">
                          <SHORT-NAME>NvMEaRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">EEPROM Abstraction</L-2>
                            <L-2 L="ZH">概述：NvMEaRef 是一个配置参数，用于指定非易失性内存块（NvM Block）与底层的Eeprom Abstraction层的关联，确保数据正确存储到EEPROM或其他非易失性存储介质中。</L-2>
                            <L-2 L="ZH">注意：在配置NvMEaRef时，必须确保引用的Eeprom Abstraction层的标识符与NvM Block兼容；如果系统中存在多个非易失性存储设备，需要正确映射以避免数据存储错误；</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00487</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <REFERENCES>
                            <ECUC-REFERENCE-DEF UUID="ECUC:378ccf77-6afa-4fb2-814c-d86e91c3bbc8">
                              <SHORT-NAME>NvMNameOfEaBlock</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">reference to EaBlock</L-2>
                                <L-2 L="ZH">概述：NvMNameOfEaBlock 配置项用于定义非易失性内存管理（NvM）模块中，每个Eeprom Abstraction（Ea）块的名称。</L-2>
                                <L-2 L="ZH">注意：确保每个Ea块的名称在整个项目中是唯一的，以避免数据存储时的冲突；名称应符合项目的命名规范；对Ea块的命名没有特定的长度限制，但应保持合理以便于管理和维护。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00488</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <REQUIRES-SYMBOLIC-NAME-VALUE>true</REQUIRES-SYMBOLIC-NAME-VALUE>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Ea/EaBlockConfiguration</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5c319a41-37d1-4b63-8011-c8bf807095f5">
                          <SHORT-NAME>NvMFeeRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Flash EEPROM Emulation</L-2>
                            <L-2 L="ZH">概述：NvMFeeRef 是一个配置参数，用于引用非易失性内存管理模块中的 FEE（Flash EEPROM Emulation）块，确保数据的持久存储。</L-2>
                            <L-2 L="ZH">注意：确保引用的FEE块在系统中是唯一的，并且已经正确配置；在配置NvMFeeRef时，需要考虑数据的读写频率和存储容量需求；</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00489</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <REFERENCES>
                            <ECUC-REFERENCE-DEF UUID="ECUC:48167eeb-a01f-4420-a942-3a98967b1fbb">
                              <SHORT-NAME>NvMNameOfFeeBlock</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">reference to FeeBlock</L-2>
                                <L-2 L="ZH">概述：NvMNameOfFeeBlock是一个配置参数，用于指定非易失性内存管理（NvM）模块中特定块的Flash EEPROM Emulation (FEE) 模块的块名称。</L-2>
                                <L-2 L="ZH">注意：在配置时，必须确保NvMNameOfFeeBlock的值与FEE模块中定义的块名称完全匹配；该名称通常由系统生成，手动修改可能会导致数据不一致；在配置多个NvM块时，每个块的NvMNameOfFeeBlock应该是唯一的，以避免名称冲突。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00490</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <REQUIRES-SYMBOLIC-NAME-VALUE>true</REQUIRES-SYMBOLIC-NAME-VALUE>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Fee/FeeBlockConfiguration</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </CHOICES>
                    </ECUC-CHOICE-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:629d2250-f495-4827-9660-195f8642e4fd">
                  <SHORT-NAME>NvMCommon</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Container for common configuration options.</L-2>
                    <L-2 L="ZH">概述：NvMCommon配置项是用于定义非易失性内存管理模块（NvM）的通用属性，如NvM模块的版本信息、多块管理策略以及客户端服务器通信机制等。</L-2>
                    <L-2 L="ZH">注意：在配置多块管理策略时，考虑数据一致性和访问效率；客户端服务器通信配置需满足系统的实时性和可靠性要求。</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00028</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:70475090-57ec-4ce9-afdc-d82075f01a78">
                      <SHORT-NAME>NvMBswMMultiBlockJobStatusInformation</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter specifies whether BswM is informed about the current status of the multiblock job.</L-2>
                        <L-2 L="ZH">概述：NvMBswMMultiBlockJobStatusInformation配置项用于定义非易失性内存管理（NvM）模块中多块作业的状态信息，这有助于监控和控制多个块的读写作业的执行状态。</L-2>
                        <L-2 L="ZH">注意：需要确保该配置项正确反映了所有相关NvM块的作业状态；此配置项通常与NvM的作业管理和错误检测机制紧密相关；在配置时，应注意与NvM块配置的一致性和数据类型的正确性，以确保系统的健壮性。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">True: call  BswM_NvM_CurrentJobMode if ReadAll and WriteAll are started, finished, canceled
                                        False: do not inform BswM at all</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00550</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d54c9a22-5fb3-489c-9a6d-bbd5d848859c">
                      <SHORT-NAME>NvMDevErrorDetect</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Switches the development error detection and notification on or off.</L-2>
                        <L-2 L="ZH">概述：NvMDevErrorDetect 是一个配置参数，用于启用或禁用非易失性内存管理（NvM）模块的开发错误检测和报告机制。</L-2>
                        <L-2 L="ZH">注意：在生产代码中通常禁用此功能以节省资源，但在开发和测试阶段应启用以便于故障诊断；确保与系统的诊断策略一致；此配置应与其他模块的错误检测配置保持一致性。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">* true: detection and notification is enabled.
                                        * false: detection and notification is disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00495</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e2f92e79-6cf7-433b-89c4-7453b7617a22">
                      <SHORT-NAME>NvMDrvModeSwitch</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable switching memory drivers to fast mode during performing nvm_read_all and nvm_write_all</L-2>
                        <L-2 L="ZH">概述：NvMDrvModeSwitch 配置项用于控制非易失性内存（NVM）驱动的模式切换，允许系统在不同的操作模式间切换，以适应不同的数据存储和管理需求。</L-2>
                        <L-2 L="ZH">注意：确保NvMDrvModeSwitch配置与系统定义的模式管理策略一致；正确配置模式切换以避免数据一致性问题；在多模式系统中，注意模式切换对系统性能的影响。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	Fast mode enabled.
                                        false:	Fast mode disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00496</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:87a82f46-5ed9-45cb-909e-6d826c161f36">
                      <SHORT-NAME>NvMDynamicConfiguration</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable the dynamic configuration management handling by the nvm_read_all request.</L-2>
                        <L-2 L="ZH">概述：NvMDynamicConfiguration 是用于描述非易失性内存（NvM）模块中动态配置参数的配置项，它允许在运行时更改NvM的某些行为和属性，如块管理类型、块大小等。</L-2>
                        <L-2 L="ZH">注意：动态配置通常受限，因为大多数NvM参数在编译时就已确定；如果实现了动态配置，必须确保运行时的更改不会违反系统的安全和一致性要求；此外，动态配置可能需要额外的RAM资源和处理时间，因此在资源受限的系统中使用时应谨慎。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	Dynamic configuration management handling enabled.
                                        false:	Dynamic configuration management handling disabled.

                                        This parameter affects all NvM processing related to Block with ID 1 and all processing related to Resistant to Changed Software. If the Dynamic Configuration is disabled, Block 1 cannot be used by NvM.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00497</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8105b3ea-e773-4f2e-9f89-22e9e58f874b">
                      <SHORT-NAME>NvMJobPrioritization</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable job prioritization handling</L-2>
                        <L-2 L="ZH">概述：NvMJobPrioritization配置项用于定义非易失性内存管理（NvM）作业的优先级，确保在资源竞争时，高优先级的作业可以优先执行。</L-2>
                        <L-2 L="ZH">注意：在配置NvMJobPrioritization时，需要确保优先级设置反映了系统的实际需求和约束；不恰当的优先级分配可能导致低优先级作业饥饿；作业优先级的具体实现方式可能受到底层存储设备特性的影响。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	Job prioritization handling enabled.
                                        false:	Job prioritization handling disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00498</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:053fb1f7-d703-4773-a004-87391a430d45">
                      <SHORT-NAME>NvMPollingMode</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable/disable the polling mode in the NVRAM Manager and at the same time disable/enable the callback functions useable by lower layers</L-2>
                        <L-2 L="ZH">概述：NvMPollingMode配置项用于定义非易失性内存管理（NvM）模块中数据读写操作的完成检测方式，即是通过轮询（Polling）还是中断（Interrupt）来确认操作是否完成。</L-2>
                        <L-2 L="ZH">注意：选择轮询模式可能会影响系统的实时性，因为CPU需要定期检查操作状态；轮询模式在处理大量或耗时的I/O操作时可能不如中断模式高效；选择合适的模式需考虑系统的实时性要求和资源消耗。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	Polling mode enabled, callback function usage disabled.
                                        false:	Polling mode disabled, callback function usage enabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00501</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6e124429-e18f-4b2c-b790-6cad1259de79">
                      <SHORT-NAME>NvMSetRamBlockStatusApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable the API nvm_set_ram_block_status.</L-2>
                        <L-2 L="ZH">概述：NvMSetRamBlockStatusApi是一个配置项，用于启用或禁用NvM模块中的API，该API允许应用程序改变RAM块的状态，例如将其标记为已改变或未改变。</L-2>
                        <L-2 L="ZH">注意：确保在使用此API之前已经正确配置了NvM模块；此API的使用可能会影响NvM的性能，特别是在频繁更新数据时；使用此API需要确保对数据一致性和完整性的管理。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	API nvm_set_ram_block_status enabled.
                                        false:	API nvm_set_ram_block_status disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00502</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:505b5889-cc12-4684-aef0-cf8c9d71176e">
                      <SHORT-NAME>NvMVersionInfoApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Pre-processor switch to enable / disable the API to read out the modules version information [NVM285], [NVM286].</L-2>
                        <L-2 L="ZH">概述：NvMVersionInfoApi 是一个配置参数，用于启用或禁用非易失性内存管理（NvM）模块的版本信息API，允许用户获取模块的版本信息。</L-2>
                        <L-2 L="ZH">注意：如果启用了该配置项，必须确保NvM模块提供了一个函数来返回其版本信息；如果禁用，则不应该包含相关的版本信息API函数；此外，需要注意版本信息API的使用可能会增加代码的大小和复杂性。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">true:	Version info API enabled.
                                        false:	Version info API disabled.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00505</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:5b839f42-032f-48fd-9d5f-a80f7eaf4e60">
                      <SHORT-NAME>NvMApiConfigClass</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Preprocessor switch to enable some API calls which are related to NVM API configuration classes.</L-2>
                        <L-2 L="ZH">概述：NvMApiConfigClass 配置项用于指定NVRAM管理器（NvM）模块的API配置类别，它决定了NvM模块提供的API集合，以及这些API的功能和性能特性。</L-2>
                        <L-2 L="ZH">注意：在选择NvMApiConfigClass时，需要根据系统需求和内存限制来确定合适的配置类别；不同的配置类别可能会影响系统的内存占用和API的执行时间；应确保所选配置类别与标准定义的API集合一致。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00491</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:029f5504-9bcd-8922-3df8-f49c151cebb4">
                          <SHORT-NAME>NVM_API_CONFIG_CLASS_1</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:e9b3c3f7-62bb-8e24-3087-6fd2761044c1">
                          <SHORT-NAME>NVM_API_CONFIG_CLASS_2</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:56007de6-1fa7-9716-2571-e67347107e0e">
                          <SHORT-NAME>NVM_API_CONFIG_CLASS_3</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:f5f461c3-4f1c-4a92-b0d4-d967c1d6f08e">
                      <SHORT-NAME>NvMMainFunctionPeriod</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The period between successive calls to the main function in seconds.</L-2>
                        <L-2 L="ZH">概述：NvMMainFunctionPeriod 配置项定义了非易失性内存管理模块（NvM）主函数的调用周期，即NvM_MainFunction的调度频率。</L-2>
                        <L-2 L="ZH">注意：该值应与系统定时器和任务调度策略相匹配，以确保数据的及时处理和存储；过高的调用频率可能导致系统资源过度占用，而过低的频率可能导致数据存储延迟；在配置时需考虑到ECU的性能和内存操作的实时性要求。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:Display">
                            <SD GID="VCOS:BaseUnit">s</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00555</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX INTERVAL-TYPE="OPEN">Inf</MAX>
                      <MIN INTERVAL-TYPE="OPEN">0</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:cd0e20fd-32f3-44cd-b73a-fed99a446e01">
                      <SHORT-NAME>NvMMultiBlockCallback</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Entry address of the common callback routine which shall be invoked on termination of each asynchronous multi block request</L-2>
                        <L-2 L="ZH">概述：NvMMultiBlockCallback配置项用于定义在非易失性内存（NvM）模块中，当多个块的读写操作完成后触发的回调函数，以便进行后续处理或状态更新。</L-2>
                        <L-2 L="ZH">注意：该回调函数应仅用于通知目的，避免在其中执行耗时或复杂的操作；确保回调函数的执行时间短，以不影响系统性能；在配置时需确保回调函数与NvM模块兼容</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00500</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                    </ECUC-FUNCTION-NAME-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5900b6cf-53e9-49d8-878f-65aed90f88f6">
                      <SHORT-NAME>NvMCompiledConfigId</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configuration ID regarding the NV memory layout. This configuration ID shall be published as e.g. a SW-C shall have the possibility to write it to NV memory.</L-2>
                        <L-2 L="ZH">概述：NvMCompiledConfigId 是用于标识非易失性内存管理（NvM）模块配置的编译时配置ID，确保配置的一致性和正确性。</L-2>
                        <L-2 L="ZH">注意：该ID应与生产环境中使用的配置ID匹配，以避免数据不一致问题；在软件升级或配置更改时需谨慎处理，确保新旧配置间的兼容性；确保该配置项的正确设置和使用，以符合标准要求。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00492</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:18ffdb77-2c48-49d0-a34c-55bad1ed237c">
                      <SHORT-NAME>NvMCrcNumOfBytes</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">If CRC is configured for at least one NVRAM block, this parameter defines the maximum number of bytes which shall be processed within one cycle of job processing.</L-2>
                        <L-2 L="ZH">概述：NvMCrcNumOfBytes 配置项用于指定非易失性内存（NVM）模块中用于计算循环冗余校验（CRC）的数据字节数。</L-2>
                        <L-2 L="ZH">注意：必须确保此配置项与实际存储的数据块大小相匹配；CRC字节数的配置应考虑到数据完整性和性能之间的平衡；在配置时应遵循项目或组织的数据保护策略。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                            <SD GID="VCOS:CfgValue">65535</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00493</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c9acf3f3-3f67-48b6-99b6-61a6378e6ed1">
                      <SHORT-NAME>NvMDatasetSelectionBits</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the number of least significant bits which shall be used to address a certain dataset of a NVRAM block within the interface to the memory hardware abstraction.</L-2>
                        <L-2 L="ZH">概述：NvMDatasetSelectionBits 配置项用于定义非易失性内存（NvM）中数据集的选择位数，这些位数决定了可以区分的数据集的数量，从而支持多版本数据存储。</L-2>
                        <L-2 L="ZH">注意：在配置NvMDatasetSelectionBits时，需要确保所选位数足以覆盖所有需要的数据集版本；此配置项的值会影响NvM模块的RAM和ROM占用，因为它决定了数据集索引的大小；应检查该配置项是否与NvM模块的其他配置参数兼容，以确保数据集管理的正确性。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">0..8: Number of bits which are used for dataset or redundant block addressing.

                                        0: No dataset or redundant NVRAM blocks are configured at all, no selection bits required.

                                        1: In case of redundant NVRAM blocks are configured, but no dataset NVRAM blocks.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00494</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>8</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:51308b85-4893-4a39-a736-7283da5f78ca">
                      <SHORT-NAME>NvMRepeatMirrorOperations</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Defines the number of retries to let the application copy data to or from the NvM module's mirror before postponing the current job.</L-2>
                        <L-2 L="ZH">概述：NvMRepeatMirrorOperations配置项用于定义是否在镜像块操作失败后重复尝试操作，以提高数据存储的可靠性。</L-2>
                        <L-2 L="ZH">注意：在使用此配置时，需要考虑系统的容错需求和重试操作可能带来的额外时间开销；重试机制应与系统的诊断策略和恢复策略相协调；具体实现可能依赖于供应商的NvM模块实现。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_NvM_00518</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
