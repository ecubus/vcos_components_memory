{
    "NVM012001": {
        "rule_name": "NVM012001",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of NvMCalcRamBlockCrc and NvMBlockUseCrc.",
        "rule_message": "NvMBlockUseCrc should be 'true' if NvMCalcRamBlockCrc is 'true'.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/NvM/NvMBlockDescriptor",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/NvM/NvMBlockDescriptor/NvMCalcRamBlockCrc",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "or"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/NvM/NvMBlockDescriptor/NvMBlockUseCrc",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
